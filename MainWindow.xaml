<Window x:Class="FocusDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusDeck"
        Height="700"
        Width="900"
        MinHeight="540"
        MinWidth="720"
        Background="#191919"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#191919">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Grid Background="#191919" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <Border Width="25" Height="17" Background="#2F95D1" CornerRadius="1" Margin="0,0,14,0" />
                <TextBlock Text="FocusDeck" FontSize="19" Foreground="#F0F0F2" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="程序快捷唤起" FontSize="14" Foreground="#A9A9AD" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Background="#202020" Padding="30,26,30,26" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Height="184" CornerRadius="12" ClipToBounds="True" Background="#151818" BorderBrush="#353535" BorderThickness="1" Margin="0,0,0,22">
                    <Grid>
                        <Image Source="Assets/cover.jpg" Stretch="UniformToFill" Opacity="0.45" />
                        <Rectangle Fill="#DD111212" />
                        <StackPanel Margin="26,0,0,24" VerticalAlignment="Bottom">
                            <TextBlock Text="FocusDeck" Foreground="#FFFFFF" FontSize="29" FontWeight="SemiBold" />
                            <TextBlock Text="一键唤起你的工作窗口" Foreground="#D6D3C8" FontSize="15" Margin="0,7,0,0" />
                        </StackPanel>
                        <Image Source="Assets/cover.jpg" Width="184" Height="184" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,34,0" />
                    </Grid>
                </Border>

                <Border Background="#2B2B2B" BorderBrush="#353535" BorderThickness="1" CornerRadius="9" Padding="27,22" Margin="0,0,0,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自动启动" Foreground="#F0F0F2" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Windows 登录后在后台启动，可随时使用配置的快捷键。" Foreground="#BDBDC2" FontSize="15" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StartupStateText" Text="已关闭" Foreground="#A8A8AD" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ToggleButton x:Name="StartupToggle" Width="72" Height="34" Content="" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="程序唤起快捷键" Foreground="#F0F0F2" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="按下快捷键切换到程序窗口；窗口已在前台时再次按下会最小化。" Foreground="#BDBDC2" FontSize="15" Margin="0,7,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="添加程序" Click="AddApplication_Click" Background="#43A6F3" Foreground="#08121C" Padding="18,10" />
                </Grid>

                <StackPanel x:Name="ApplicationsPanel" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="#1D1D1D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeText" VerticalAlignment="Center" Foreground="#AEECC6" Margin="28,0,0,0" />
            <Button Grid.Column="1" Content="取消修改" Click="Reset_Click" Margin="0,0,12,0" Padding="18,10" />
            <Button Grid.Column="2" Content="保存设置" Click="Save_Click" Margin="0,0,28,0" Background="#43A6F3" Foreground="#08121C" Padding="18,10" />
        </Grid>
    </Grid>
</Window>
