<Window x:Class="FocusDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FocusDeck"
        Width="1228"
        Height="818"
        MinWidth="980"
        MinHeight="680"
        Background="#070B12"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#070B12" />
        <SolidColorBrush x:Key="CardBrush" Color="#121820" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#26303D" />
        <SolidColorBrush x:Key="InputBrush" Color="#151A22" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#2B3542" />
        <SolidColorBrush x:Key="TextBrush" Color="#F7F8FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B8C0CC" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7F8FA" />
            <Setter Property="Background" Value="#151A22" />
            <Setter Property="BorderBrush" Value="#2B3542" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D2530" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3C7AC0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#10151D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#126CE7" />
            <Setter Property="BorderBrush" Value="#238BFF" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#17202B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0E141C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F7F8FA" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CaretBrush" Value="#F7F8FA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2F8DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F7F8FA" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9,34,9" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" />
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              TextElement.Foreground="#F7F8FA" />
                                            <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                  Fill="#B8C0CC"
                                                  Width="10"
                                                  Height="5"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,15,0" />
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F7F8FA"
                                     CaretBrush="#F7F8FA"
                                     Margin="{TemplateBinding Padding}"
                                     VerticalContentAlignment="Center" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#111820"
                                        BorderBrush="#2F8DFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2F8DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F7F8FA" />
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#15345E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#126CE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="#222933" BorderBrush="#2E3947" BorderThickness="1" CornerRadius="17" />
                            <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11" Background="#DDE7F7" HorizontalAlignment="Left" Margin="6,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#126CE7" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#238BFF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,6,0" />
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#33404F" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#33404F" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#070B12" BorderBrush="#2B3542" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Grid Background="#0A0F16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <Image Source="Assets/ui/app-icon-titlebar.png" Width="28" Height="28" Margin="0,0,14,0" />
                    <TextBlock Text="FocusDeck" FontSize="18" FontWeight="SemiBold" Foreground="#F7F8FA" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Text="程序快捷唤起" FontSize="16" Foreground="#B8C0CC" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,12,18,0" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButtonStyle}" Content="-" Click="Minimize_Click" />
                    <Button Style="{StaticResource ChromeButtonStyle}" Content="□" Click="Maximize_Click" />
                    <Button Style="{StaticResource ChromeButtonStyle}" Content="×" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Background="#070B12" Padding="37,20,37,18" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Height="185" CornerRadius="7" BorderBrush="#30405A" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,15">
                        <Image Source="Assets/ui/hero-banner.png" Stretch="Fill" />
                    </Border>

                    <Border Background="#D9111820" BorderBrush="#26303D" BorderThickness="1" CornerRadius="7" Padding="28,18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="Assets/ui/startup-icon-card.png" Width="56" Height="56" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="开机自动启动" Foreground="#F7F8FA" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Windows 登录后在后台启动，可随时使用配置的快捷键。" Foreground="#B8C0CC" FontSize="16" Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#331A2430" CornerRadius="17" Padding="16,6" Margin="0,0,14,0">
                                    <TextBlock x:Name="StartupStateText" Text="已关闭" Foreground="#B8C0CC" FontSize="15" VerticalAlignment="Center" />
                                </Border>
                                <ToggleButton x:Name="StartupToggle" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#D9111820" BorderBrush="#26303D" BorderThickness="1" CornerRadius="7" Padding="28,22,28,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="Assets/ui/shortcut-icon-card.png" Width="56" Height="56" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="程序唤起快捷键" Foreground="#F7F8FA" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="按下快捷键切换到程序窗口；窗口已在前台时再次按下会最小化。" Foreground="#B8C0CC" FontSize="16" Margin="0,7,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Width="150" Height="44" Content="添加程序    +" Click="AddApplication_Click" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>

                            <StackPanel x:Name="ApplicationsPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="#070B12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="37,0,0,0">
                    <Image Source="Assets/ui/success-status-icon.png" Width="26" Height="26" Margin="0,0,16,0" />
                    <TextBlock x:Name="NoticeText" Text="设置已保存，快捷键已生效。" VerticalAlignment="Center" Foreground="#73E070" FontSize="15" />
                </StackPanel>
                <Button Grid.Column="1" Width="138" Height="42" Content="取消修改" Click="Reset_Click" Margin="0,0,18,0" />
                <Button Grid.Column="2" Width="146" Height="42" Content="保存设置" Click="Save_Click" Margin="0,0,37,0" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
